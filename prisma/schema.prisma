datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Money is stored as NUMERIC(14,2) and converted to integer paisa (cents) for
// every calculation — never JavaScript floating point. Calendar dates
// (expense / income dates) are stored as DATE so they cannot shift across
// timezones. Balances and "budget remaining" values are always derived from
// transactions and never stored.

enum ExpenseType {
  HOME
  SHOPPING
  OUTING
}

enum UserRole {
  OWNER
  MEMBER
}

model User {
  id           String    @id @default(cuid())
  // Sign-in name, stored lowercase. Required by the app (nullable only so the column can be added to existing rows).
  username     String?   @unique
  email        String?   @unique
  name         String
  passwordHash String
  role         UserRole  @default(OWNER)
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([householdId])
}

model Household {
  id              String           @id @default(cuid())
  name            String           @default("My Household")
  currency        String           @default("PKR")
  currencySymbol  String           @default("Rs.")
  startingBalance Decimal          @default(0) @db.Decimal(14, 2)
  dateFormat      String           @default("MMM D, YYYY")
  timezone        String           @default("Asia/Karachi")
  onboardedAt     DateTime?
  users           User[]
  homeCategories  HomeCategory[]
  shoppingMembers ShoppingMember[]
  expenses        Expense[]
  incomes         Income[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model HomeCategory {
  id                    String    @id @default(cuid())
  householdId           String
  household             Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name                  String
  expectedMonthlyAmount Decimal   @default(0) @db.Decimal(14, 2)
  isActive              Boolean   @default(true)
  sortOrder             Int       @default(0)
  icon                  String?
  expenses              Expense[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([householdId, sortOrder])
}

model ShoppingMember {
  id          String           @id @default(cuid())
  householdId String
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  budgets     ShoppingBudget[]
  expenses    Expense[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([householdId, sortOrder])
}

// One row per member per year, so changing next year's budget never rewrites
// history: Qumail 2025 = 35,000 and Qumail 2026 = 40,000 live side by side.
model ShoppingBudget {
  id           String         @id @default(cuid())
  memberId     String
  member       ShoppingMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year         Int
  budgetAmount Decimal        @default(0) @db.Decimal(14, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([memberId, year])
}

model Income {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(14, 2)
  date        DateTime  @db.Date
  description String
  source      String?
  // Which money pot this was added to (Home / Outing / Shopping). Null = general.
  pot         ExpenseType?
  // Client-generated idempotency key so offline-queued records never duplicate.
  clientId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([householdId, clientId])
  @@index([householdId, date])
  @@index([householdId, pot])
  @@index([householdId, date, createdAt])
}

model Expense {
  id               String          @id @default(cuid())
  householdId      String
  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  type             ExpenseType
  amount           Decimal         @db.Decimal(14, 2)
  date             DateTime        @db.Date
  description      String
  notes            String?

  homeCategoryId   String?
  homeCategory     HomeCategory?   @relation(fields: [homeCategoryId], references: [id], onDelete: Restrict)

  shoppingMemberId String?
  shoppingMember   ShoppingMember? @relation(fields: [shoppingMemberId], references: [id], onDelete: Restrict)

  // Outing details
  place            String?
  numberOfPeople   Int?
  paymentMethod    String?

  // Client-generated idempotency key so offline-queued records never duplicate.
  clientId         String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([householdId, clientId])
  @@index([householdId, date])
  @@index([householdId, type, date])
  @@index([householdId, shoppingMemberId, date])
  @@index([householdId, homeCategoryId, date])
  @@index([householdId, type, homeCategoryId])
  @@index([householdId, type, shoppingMemberId])
  @@index([householdId, date, createdAt])
}

// Recurring expenses (future): a `RecurringExpense` template table
// (householdId, type, homeCategoryId, amount, dayOfMonth, enabled=false) can be
// added without touching Expense — generated rows are ordinary Expenses with a
// nullable recurringId. Nothing is auto-inserted unless explicitly enabled.
