# PostgreSQL connection (e.g. Neon). Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&connect_timeout=30"

# Random string, at least 32 characters: openssl rand -base64 48
JWT_SECRET=""

# Sign-up is only open while there are no users. Set to "true" to allow more accounts.
# SIGNUP_ENABLED="false"
